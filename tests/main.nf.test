nextflow_pipeline {

    name "The 2800M control of tests/data/ through the whole pipeline (-profile test)"
    script "../main.nf"
    tag "pipeline"

    test("2800M: its haplotype, and the report and FDSTOOLS' sequences as before") {

        when {
            params {
                outdir = "$outputDir"
            }
        }

        then {
            def sample = "2800M-DVJ49_S1_L001"
            // the report's cells as text, row by row (tests/lib/ExcelReport.groovy)
            def report = ExcelReport.rows("$outputDir/p13_report/${sample}_separate_frame.xlsx")
            def fmp = report[0].indexOf("FMP"), vf = report[0].indexOf("vf_FDS")
            // the calls with more than 50% of the reads
            def majors = report.drop(1).findAll { it[vf].isNumber() && (it[vf] as double) > 50 }.collect { it[fmp] }
            assertAll(
                { assert workflow.success },
                { assert majors == ["T152C", "A263G", "-315.1C", "T477C", "A750G", "A1438G", "G3010A", "A4769G",
                                    "A8860G", "A15326G", "T16519C"] },
                { assert snapshot(report, path("$outputDir/p12_fdstools/${sample}/${sample}.sast.csv")).match() }
            )
        }
    }
}
