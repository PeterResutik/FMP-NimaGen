// Parameters: defaults for every --option (see README.md, Main Options); printed in p00_parameters.txt
params {
    reads = "${projectDir}/raw_data/*_{R1,R2}_001.fastq.gz"
    reference = "${projectDir}/resources/rCRS/rCRS_NimaGen.fasta"

    // flash
    min_overlap = 10 // default in FLASH is 10
    max_overlap = 226 // the read length: FLASH counts mismatches over at most this many overlap bases (default 65), and no overlap is longer than a read
    max_mismatch_density = 0.25 //default in FLASH is 0.25

    publish_dir_mode = "symlink"
    outdir = "results"
    publish_bams = true // false: BAM/FASTQ intermediates are not copied to outdir (e.g. simulations); VCFs, FDSTOOLS files, QC and the merged Excel still are

    adapter = 'ATCATAACAAAAAATTTCCACCAAA' // chrM:278-302, just before the poly-C tract at 303-315: R1 is cut after it (p03)

    left_primers = "${projectDir}/resources/primers/left_primers.fasta"
    right_primers_rc = "${projectDir}/resources/primers/right_primers_rc.fasta"
    amplicon_middle_positions = "${projectDir}/resources/amplicon_bed/amplicons_bed.txt"

    // cutadapt
    minimum_length = 60
    maximum_length = 600 // longer than any merged 2x226 read, so products spanning two amplicons are kept
    primer_min_overlap = 15 // bases of a primer that must be in the read when it is incomplete at the read end

    // bwa mem in p08 (primer-trimmed merged reads, judged by rtn in p09)
    clipping_penalty = "100,100" // bwa mem -L; bwa default is 5,5

    humans_index_dir = "${projectDir}/resources/rtn_files/humans"
    humans_index_base = "humans_NimaGen_2026-10-30.fa" // built by resources/rtn_files/humans/build/ from public sources

    numts_index_dir = "${projectDir}/resources/rtn_files/numts"
    numts_index_base = "Calabrese_Dayama_Smart_Numts_modified.fa"
    rtn_positions = "${projectDir}/resources/rtn_files/positions/recurrent_positions.tsv" // rtn sees these positions at base quality 2; none = off
    rtn_memory = "4 GB" // memory per rtn task (p09), which holds the humans index (about 2 GB): Nextflow starts no more tasks than the computer's memory holds

    fdstools_library = "${projectDir}/resources/fdstools/mtNG_library_file.txt"

    // rtn
    mapQ = 30
    skip_numt_filter = false // true skips rtn, e.g. for simulated reads, which contain no NUMTs; the MAPQ filter still applies

    // fdstools
    minimum = 2
    num_threads = 6 // threads of FDSTOOLS tssv (p12), which reserves as many cores (at most the computer's); no faster beyond 6
    min_abs = 2
    min_pct_of_max = 0
    min_pct_of_sum = 3
    allele_min_abs = 2
    allele_min_pct_of_max = 0
    allele_min_pct_of_sum = 3

    baseQ = 30 // minimum base quality: FDSTOOLS (TSSV) distrusts lower bases

    python_script_remove_scb = "${projectDir}/resources/scripts/remove_soft_clipped_bases_improved.py"
    python_script_generate_read_depth_plot = "${projectDir}/resources/scripts/generate_read_depth_plot_improved.py"
    python_script_process_fdstools_sast = "${projectDir}/resources/scripts/process_fdstools_output_improved_better.py"
    python_script_merge_fdstools_mutect2 = "${projectDir}/resources/scripts/merge_fdstools_mutect2_improved.py"
    python_script_rtn_qualities = "${projectDir}/resources/scripts/rtn_qualities.py"

    // merging
    depth = 20
    min_vf_FDS = 2
    lh_thresh = 10 // symmetric: floor=10%, ceiling=1-10%=90% — below floor not reported, floor-ceiling reported as LHP (lowercase), above ceiling reported as major (uppercase)
    frame = "separate" // separate | shared: how 16180-16193 and 300-315 are written (resources/scripts/frames.py)
    variant_note = true // false: the report has no variant_note column
}

process {
    executor = 'local'
}

profiles {
    local {
        docker.enabled = false
    }

    // The tools in a container (Dockerfile); the pipeline folder is mounted, as some steps read files there by path
    docker {
        process.container = 'peterresutik/nimagen-pipeline:0.5.0'
        docker.enabled = true
        docker.runOptions = "-u \$(id -u):\$(id -g) --platform linux/amd64 -v ${projectDir}:${projectDir}"
    }

    singularity {
        process.container = 'docker://peterresutik/nimagen-pipeline:0.5.0'
        singularity.enabled = true
        singularity.autoMounts = true
        singularity.runOptions = "-B ${projectDir}"
    }
}

workDir = 'work'  // Directory for intermediate files

manifest {
    version = '0.5.0'
    nextflowVersion = '>=25.04.0'  // tested with 25.04.6 and 26.04.6
}
