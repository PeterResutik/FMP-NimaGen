process {
    executor = 'local'
}

profiles {
    local {
        docker.enabled = false
    }

    docker {
        process.container = 'peterresutik/nimagen-pipeline:latest'
        docker.enabled = true
        singularity.enabled = false
    }
}

workDir = 'work'  // Directory for intermediate files

manifest {
    nextflowVersion = '>=25.04.0'  // tested with 25.04.6 and 26.04.6
}
